library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity Alarme is
    Port ( clk              : in  STD_LOGIC;
           reset            : in  STD_LOGIC;
           Hour_Tens        : in  STD_LOGIC_VECTOR (3 downto 0);
           Hour_Units       : in  STD_LOGIC_VECTOR (3 downto 0);
           Min_Tens         : in  STD_LOGIC_VECTOR (3 downto 0);
           Min_Units        : in  STD_LOGIC_VECTOR (3 downto 0);
           wth_set          : in  STD_LOGIC;    -- '1' = modo de acerto do alarme
           Inc_hour         : in  STD_LOGIC;    -- pulso de 1 ciclo
           Inc_min          : in  STD_LOGIC;    -- pulso de 1 ciclo
           Hold_hour        : in  STD_LOGIC;    -- NOVO: manter premido horas
           Hold_min         : in  STD_LOGIC;    -- NOVO: manter premido minutos
           btn_fast         : in  STD_LOGIC;    -- modo de ajuste rapido (toggle)
           pulso            : in  STD_LOGIC;    
           sw_alarm         : in  STD_LOGIC;    
           Alarm_out        : out STD_LOGIC;
           Hour_Alarm_Tens  : out STD_LOGIC_VECTOR (3 downto 0);
           Hour_Alarm_Units : out STD_LOGIC_VECTOR (3 downto 0);
           Min_Alarm_Tens   : out STD_LOGIC_VECTOR (3 downto 0);
           Min_Alarm_Units  : out STD_LOGIC_VECTOR (3 downto 0));
end Alarme;

architecture Behavioral of Alarme is

    type estado_t is (OFF, A_TOCAR);
    signal st : estado_t := OFF;

    signal a_hour    : integer range 0 to 23 := 0;   
    signal a_min     : integer range 0 to 59 := 0;  
    signal cur_hour : integer range 0 to 23;
    signal cur_min  : integer range 0 to 59;

    signal match, match_d : std_logic := '0';
    signal ring_cnt        : integer range 0 to 59 := 0; 
    
    -- Sinais para o modo rápido (cópia exata do Watch_01)
    signal fast_mode     : std_logic := '0';
    signal fast_tick     : std_logic := '0';
    signal fast_cnt      : integer range 0 to 8000000 := 0; 
    signal btn_fast_prev : std_logic := '0';

begin

    cur_hour <= to_integer(unsigned(Hour_Tens)) * 10 + to_integer(unsigned(Hour_Units));
    cur_min  <= to_integer(unsigned(Min_Tens))  * 10 + to_integer(unsigned(Min_Units));

    match <= '1' when (cur_hour = a_hour and cur_min = a_min) else '0';

    -- Alternar o fast mode (toggle) ao pulsar
    process(clk, reset)
    begin
        if reset = '1' then
            fast_mode <= '0';
            btn_fast_prev <= '0';
        elsif rising_edge(clk) then
            btn_fast_prev <= btn_fast;
            if btn_fast = '1' and btn_fast_prev = '0' then
                fast_mode <= not fast_mode; -- Troca o estado (On/Off)
            end if;
            
            -- Segurança: Desativa o modo rápido ao fechar o switch da alarme
            if wth_set = '0' then
                fast_mode <= '0';
            end if;
        end if;
    end process;

    -- Gerar pulso automático contínuo
    process(clk, reset)
    begin
        if reset = '1' then
            fast_cnt <= 0;
            fast_tick <= '0';
        elsif rising_edge(clk) then
            if fast_cnt = 8000000 then 
                fast_cnt <= 0;
                fast_tick <= '1';
            else
                fast_cnt <= fast_cnt + 1;
                fast_tick <= '0';
            end if;
        end if;
    end process;

    process (clk, reset)
    begin
        if reset = '1' then
            a_hour    <= 0;
            a_min     <= 0;
            st        <= OFF;
            ring_cnt <= 0;
            match_d  <= '0';
        elsif rising_edge(clk) then
            match_d <= match;

            if wth_set = '1' then
                st       <= OFF;
                ring_cnt <= 0;
                
                -- Lógica idêntica ao relógio: Pulso normal OR (Mantido premido + Modo Rápido ativo + Tick)
                
                -- Ajuste de hora
                if (Inc_hour = '1' and fast_mode = '0') or (Hold_hour = '1' and fast_mode = '1' and fast_tick = '1') then
                    if a_hour = 23 then a_hour <= 0;
                    else a_hour <= a_hour + 1;
                    end if;
                end if;
                
                -- Ajuste de minutos
                if (Inc_min = '1' and fast_mode = '0') or (Hold_min = '1' and fast_mode = '1' and fast_tick = '1') then
                    if a_min = 59 then a_min <= 0;
                    else a_min <= a_min + 1;
                    end if;
                end if;

            else
                case st is
                    when OFF =>
                        ring_cnt <= 0;
                        if sw_alarm = '1' and match = '1' and match_d = '0' then
                            st <= A_TOCAR;
                        end if;

                    when A_TOCAR =>
                        if sw_alarm = '0' then
                            st <= OFF;               
                        elsif pulso = '1' then          
                            if ring_cnt = 59 then
                                st <= OFF;           
                            else
                                ring_cnt <= ring_cnt + 1;
                            end if;
                        end if;
                end case;
            end if;
        end if;
    end process;

    Alarm_out <= '1' when st = A_TOCAR else '0';

    Hour_Alarm_Tens  <= std_logic_vector(to_unsigned(a_hour / 10,  4));
    Hour_Alarm_Units <= std_logic_vector(to_unsigned(a_hour mod 10, 4));
    Min_Alarm_Tens   <= std_logic_vector(to_unsigned(a_min  / 10,  4));
    Min_Alarm_Units  <= std_logic_vector(to_unsigned(a_min  mod 10, 4));
end Behavioral;
